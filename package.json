{
  "name": "@huloglobal/vendure-licence-sdk",
  "version": "0.15.6",
  "description": "Shared runtime helpers for HULO's Vendure plugins: offline licence key verification, revocation and update checks, webhook signature checks, rate limiting, security headers, log retention and the plugins' weekly report.",
  "license": "AGPL-3.0-only",
  "author": "Wayne Garrison <wayne@garrison.me.uk>",
  "homepage": "https://huloglobal.com/vendure-plugins/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huloglobal/vendure-licence-sdk.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "logo.svg",
    "hulo-global-logo.svg",
    "hulo-global-logo-light.svg",
    "hulo-global-logo-dark.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@vendure/core": ">=3.0.0",
    "nodemailer": ">=6.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@vendure/core": "3.8.2",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "licence",
    "license",
    "licensing",
    "jwt"
  ],
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    }
  }
}
